# Secrets — never commit
.env
.env.local
.dev.vars

# Per-fork configuration — copy from *.example versions and edit locally.
# Tracking these would leak per-deploy resource names and cause merge
# conflicts on `git pull` upstream.
config.toml
wrangler.toml

# Wrangler local state (D1 sqlite, KV, R2 caches)
.wrangler/
worker-configuration.d.ts

# Node
node_modules/
*.log
npm-debug.log*
pnpm-debug.log*

# Frontend build
frontend/dist/
frontend/tsconfig.tsbuildinfo

# Raw exam materials — kept locally for the import script, never committed
years/
*.pdf
# 例外:講義閱讀器的 e2e 需要一份**真的** PDF 才會就緒(pdfium wasm 要能解析),
# 所以那份 1.9 KB 的合成檔要進版控。上面的 *.pdf 擋的是講義/教科書本體。
!frontend/e2e/fixtures/*.pdf

# Lecture-class source PDFs (複習班講義). ~78MB of decks that live in R2;
# scripts/import-lectures.ts reads them from here (often a symlink to the
# real PDFs outside the worktree). Must NOT be committed or deployed.
pdf/
pdf

# Auto-generated DB-fix SQL written by scripts/apply-oe-verdicts.py etc.
# These embed real user emails and question IDs — never commit to a
# public repo. Re-run the generator if you need to regenerate them.
scripts/apply-oe-*.sql

# Smoke/screenshot scratch from headless Chrome runs
.smoke/

# Local data-pipeline backups + polish cache (per-question claude -p responses)
.backups/
.polish-cache/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Packaged skill bundles / archives (built locally, distributed out-of-band).
# These can embed live secrets (e.g. a bundled .env) — never commit them.
*.zip
*.skill

# Personal tooling — Claude Code / Codex local state, except skills which
# we DO want shared with the repo so the whole team gets them.
.claude/*
!.claude/skills/
.codex/*
!.codex/skills/

# git worktrees (isolated workspaces, never committed)
.worktrees/

# Generated slide study-notes and rasterized slide images (built locally,
# large/derivable — not committed). Source PDFs in pdf/ are kept.
pdf/**/page_*_note.md
pdf/**/img/

# slide-deck output (逐字稿 / slide.html / slide.pdf / raw): generated by
# the slide-deck skill + scripts/slide_batch.py, derivable, not committed.
slides/

# Anki deck exports (生成物)
anki-deck/

# 策展中間產物 —— 可由 scripts/curate-videos.py 重新產生,D1 才是真相來源
scripts/data/

# uv 在 skill 資料夾解析出來的 lock。skill 是靠 gen-bank-bundle.mjs 打包成
# .skill 發出去的,只帶 pyproject.toml,所以這份 lock 不會被送到任何人手上
# —— 留在 repo 裡只會慢慢漂掉。
.claude/skills/*/uv.lock
