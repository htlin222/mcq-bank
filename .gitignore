# Secrets — never commit
.env
.env.local
.dev.vars

# Per-fork configuration — copy from *.example versions and edit locally.
# Tracking these would leak per-deploy resource names and cause merge
# conflicts on `git pull` upstream.
config.toml
wrangler.toml

# Wrangler local state (D1 sqlite, KV, R2 caches)
.wrangler/
worker-configuration.d.ts

# Node
node_modules/
*.log
npm-debug.log*
pnpm-debug.log*

# Frontend build
frontend/dist/
frontend/tsconfig.tsbuildinfo

# Raw exam materials — kept locally for the import script, never committed
years/
*.pdf

# Auto-generated DB-fix SQL written by scripts/apply-oe-verdicts.py etc.
# These embed real user emails and question IDs — never commit to a
# public repo. Re-run the generator if you need to regenerate them.
scripts/apply-oe-*.sql

# Smoke/screenshot scratch from headless Chrome runs
.smoke/

# Local data-pipeline backups + polish cache (per-question claude -p responses)
.backups/
.polish-cache/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Personal tooling — Claude Code / Codex local state, except skills which
# we DO want shared with the repo so the whole team gets them.
.claude/*
!.claude/skills/
.codex/*
!.codex/skills/
