{
	"name": "qa-bank-api",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"setup": "./scripts/setup.sh",
		"gen:mcq-bundle": "node scripts/gen-mcq-bundle.mjs",
		"gen:bank-bundle": "node scripts/gen-bank-bundle.mjs",
		"gen:bundles": "node scripts/gen-mcq-bundle.mjs && node scripts/gen-bank-bundle.mjs",
		"dev": "pnpm gen:bundles && wrangler dev",
		"sync-users": "node --experimental-strip-types scripts/sync-access.ts",
		"predeploy": "node --experimental-strip-types scripts/sync-access.ts && pnpm gen:bundles",
		"deploy": "wrangler deploy",
		"tail": "wrangler tail",
		"db:create": "wrangler d1 create $(node scripts/lib/cfg.mjs project.d1_db)",
		"db:migrate:local": "wrangler d1 migrations apply $(node scripts/lib/cfg.mjs project.d1_db) --local",
		"db:migrate:remote": "wrangler d1 migrations apply $(node scripts/lib/cfg.mjs project.d1_db) --remote",
		"db:pull": "./scripts/db-pull.sh",
		"vectors:backfill": "node --experimental-strip-types scripts/backfill-vectors.ts",
		"lecture-links:build": "node --experimental-strip-types scripts/build-slide-mcq-links.ts",
		"db:seed:local": "wrangler d1 execute $(node scripts/lib/cfg.mjs project.d1_db) --local --file=migrations/0004_hema_sample.sql",
		"db:seed:remote": "wrangler d1 execute $(node scripts/lib/cfg.mjs project.d1_db) --remote --file=migrations/0004_hema_sample.sql",
		"r2:create": "wrangler r2 bucket create $(node scripts/lib/cfg.mjs project.r2_bucket)",
		"import:lectures": "node --experimental-strip-types scripts/import-lectures.ts",
		"anki:build": "uv run --with genanki scripts/build-anki.py",
		"anki:build:mine": "uv run --with genanki scripts/build-anki.py --merge-basic",
		"seed:lecture-notes": "node --experimental-strip-types scripts/seed-lecture-notes.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --test 'worker/**/*.test.ts' 'frontend/src/lib/**/*.test.ts' 'scripts/lib/**/*.test.mjs'",
		"test:webkit": "pnpm --dir frontend build && node --test frontend/e2e/smoke.test.mjs frontend/e2e/gamepad.test.mjs frontend/e2e/nav-prefetch.test.mjs frontend/e2e/challenge-vote.test.mjs frontend/e2e/attempt-outbox.test.mjs frontend/e2e/study-plan.test.mjs frontend/e2e/eink.test.mjs frontend/e2e/overflow.test.mjs frontend/e2e/viewport-mode.test.mjs frontend/e2e/fab-overlap.test.mjs frontend/e2e/lectures-tabs.test.mjs frontend/e2e/note-fullscreen.test.mjs frontend/e2e/backup.test.mjs"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250501.0",
		"@types/markdown-it": "^14.1.2",
		"markdown-it": "^14.1.0",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^6.0.227",
		"typescript": "^5.4.0",
		"wrangler": "^4.0.0"
	},
	"dependencies": {
		"fflate": "^0.8.3",
		"hono": "^4.6.0",
		"jose": "^5.9.0",
		"ts-fsrs": "^5.4.1"
	}
}
