# You normally DON'T fill this in by hand — download a ready-made .skill
# (this .env already baked in with your personal key) from your profile page:
#   https://<your host>/profile  →  「MCQ 小測驗金鑰」  →  下載我的 .skill
#
# Manual fallback: copy to .env and fill in. .env is gitignored — never commit.
MCQ_API_BASE=https://qa.example.com
MCQ_API_KEY=從 /profile 下載的 .skill 取得（個人金鑰,勿外流）
MCQ_USER_EMAIL=you@example.com
