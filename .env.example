# Cloudflare credentials for setup-access.sh and sync-roster.sh.
# Copy this file to .env and fill in real values. NEVER commit .env.

# API token (create at dash.cloudflare.com/profile/api-tokens).
# Required scopes — see CLAUDE.md / docs:
#   Account: Workers Scripts (Edit), D1 (Edit), R2 (Edit),
#            Access: Apps and Policies (Edit), Pages (Edit),
#            Access: Organizations / IdP / Groups (Read)
#   Zone (hsiehting.com): DNS (Edit), Workers Routes (Edit)
CF_API_TOKEN=

# Your Cloudflare account ID (dashboard right sidebar; or `wrangler whoami`).
CF_ACCOUNT_ID=

# Filled in automatically by setup-access.sh after the Access app is created.
ACCESS_APP_ID=

# Roster sheet — published CSV export URL.
ROSTER_CSV_URL=https://docs.google.com/spreadsheets/d/14mY98NSsX5gNDogNldVcFZm5FWKYsufKj0JShHvVgnE/export?format=csv&gid=0

# Comma-separated admin emails always added to the Access roster.
ADMIN_EMAILS=ppoiu87@gmail.com

# The hostname Cloudflare Access protects.
PAGES_DOMAIN=hema-2026.hsiehting.com
